{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "buildCommand": "npm run build:app"
    },
    "webapp": {
      "root": "webapp",
      "framework": "vite",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "webapp"
      }
    }
  ],
  "alias": [
    "geld-seven.vercel.app"
  ]
}
