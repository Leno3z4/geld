# geld / Monad / Nad.fun
MONAD_NETWORK=mainnet
MONAD_RPC_URL=https://mainnet.monad.xyz/rpc
MONAD_WS_URL=
MONAD_PRIVATE_KEY=0xREPLACE_ME

LIVE_TRADING=true
AUTO_START=true

STARTING_CAPITAL_MON=38
POSITION_SIZE_PCT=24
MAX_TOTAL_EXPOSURE_PCT=90
MAX_OPEN_POSITIONS=5
GAS_RESERVE_MON=0.75
MIN_LOCAL_SCORE=50
AI_MIN_CONFIDENCE=0.58
SLIPPAGE_PCT=6
HARD_STOP_LOSS_PCT=30
TAKE_PROFIT_PCT=70
TRAILING_STOP_PCT=20
MAX_HOLD_MINUTES=240

EVENT_POLL_MS=800
POSITION_LOOP_MS=2200
AI_POSITION_REVIEW_MS=30000
AI_FAST_COOLDOWN_MS=4000
CANDIDATE_MAX_AGE_SECONDS=180

NADFUN_API_KEY=
GEMINI_API_KEYS=
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_ESCALATION_MODEL=gemini-3.8-flash

STATE_SYNC_URL=https://YOUR-GELD-WORKER.workers.dev/internal/state/singleton
STATE_SYNC_SECRET=
STATE_FILE=./data/state.json
BOT_PORT=8787

# Vercel app proxy (frontend/API only)
GELD_CLOUDFLARE_URL=https://YOUR-GELD-WORKER.workers.dev
GELD_CLOUDFLARE_SECRET=


# LeverUp hosted-agent mode
# Generate locally, store LEVERUP_AGENT_PRIVATE_KEY as a Cloudflare secret, and never commit the key.
LEVERUP_AGENT_PRIVATE_KEY=
# LIMIT_OPEN (2) + MARKET_CLOSE (1) = 6. Explicit mask; no wildcard by default.
LEVERUP_AGENT_PERMISSION_MASK=6
