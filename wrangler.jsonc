{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geld",
  "main": "worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "BOT_PORT": "8787" },
  "containers": [
    {
      "class_name": "GeldContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic",
      "rollout_active_grace_period": 300
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GELD_CONTAINER", "class_name": "GeldContainer" },
      { "name": "GELD_STATE", "class_name": "GeldState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GeldContainer", "GeldState"] }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
