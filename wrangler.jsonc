{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geld",
  "main": "worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "GELD_CONFIG": "{\"GELD_LIVE_TRADING\":\"true\",\"GELD_AUTO_START\":\"true\",\"MONAD_RPC_URL\":\"https://rpc.monad.xyz\",\"MIN_LIQUIDITY_USD\":\"2500\",\"MIN_LOCAL_SCORE\":\"35\",\"AI_MIN_CONFIDENCE\":\"0.45\",\"DIP_MIN_PCT\":\"3\",\"DIP_MAX_PCT\":\"50\",\"RECOVERY_MIN_PCT\":\"-10\",\"TREND_MAX_1H_PCT\":\"20\",\"AI_FALLBACK_ENABLED\":\"true\",\"AI_FALLBACK_MIN_SCORE\":\"55\",\"MIN_MARKET_CAP_USD\":\"25000\",\"MIN_ESTABLISHED_AGE_MINUTES\":\"10\",\"MIN_HOLDERS\":\"10\",\"MIN_VOLUME_USD\":\"1000\",\"MIN_VOLUME_5M_USD\":\"1000\",\"HARD_STOP_LOSS_PCT\":\"22\",\"TAKE_PROFIT_PCT\":\"55\",\"TRAILING_STOP_PCT\":\"15\",\"MAX_HOLD_MINUTES\":\"180\",\"PROFIT_TAKE_1_PCT\":\"3\",\"PROFIT_TAKE_1_SELL_PCT\":\"40\",\"PROFIT_TAKE_2_PCT\":\"30\",\"PROFIT_TAKE_2_SELL_PCT\":\"35\",\"PROFIT_TAKE_3_PCT\":\"50\",\"PROFIT_TAKE_3_SELL_PCT\":\"100\",\"PROFIT_PROTECTION_START_PCT\":\"12\",\"PROFIT_PROTECTION_FLOOR_PCT\":\"5\",\"PROFIT_PROTECTION_RATIO\":\"0.40\",\"EARLY_EXIT_LOSS_PCT\":\"-10\",\"EARLY_EXIT_TREND_1H_PCT\":\"-8\",\"MOMENTUM_EXIT_PROFIT_PCT\":\"8\",\"MOMENTUM_EXIT_TREND_1H_PCT\":\"-10\",\"MOMENTUM_EXIT_REBOUND_1H_PCT\":\"2\",\"SELL_PRESSURE_EXIT_RATIO\":\"0.65\",\"SELL_PRESSURE_MIN_VOLUME_USD\":\"1000\",\"MIN_TREND_4H_PCT\":\"-25\",\"LIQUIDITY_EXIT_RATIO\":\"0.65\",\"MAX_QUOTE_FAILURES\":\"3\",\"LOG_CHUNK_BLOCKS\":\"100\",\"MAX_LOG_CHUNKS_PER_CYCLE\":\"4\",\"STATE_SYNC_URL\":\"https://geld.mahoraga6190.workers.dev/internal/state/singleton\",\"AI_OVERRIDE_SCORE\":\"75\",\"AI_CANDIDATE_COOLDOWN_MS\":\"30000\",\"PRICE_SAMPLE_MS\":\"60000\",\"STALE_LOSS_EXIT_MINUTES\":\"45\",\"STALE_LOSS_EXIT_PCT\":\"-4\",\"DEAD_MONEY_EXIT_MINUTES\":\"90\",\"DEAD_MONEY_MAX_PNL_PCT\":\"3\",\"DUST_POSITION_MON\":\"0.05\",\"DAILY_MEAN_EXIT_PCT\":\"1.5\",\"DAILY_MIN_SAMPLES\":\"24\",\"FAST_CYCLE_MS\":\"10000\",\"PENDING_EXECUTION_TIMEOUT_MS\":\"300000\",\"LOW_CAP_MOMENTUM_ENABLED\":\"true\",\"LOW_CAP_MIN_MARKET_CAP_USD\":\"8000\",\"LOW_CAP_MAX_MARKET_CAP_USD\":\"25000\",\"LOW_CAP_MIN_LIQUIDITY_USD\":\"2500\",\"LOW_CAP_MIN_HOLDERS\":\"10\",\"LOW_CAP_MIN_VOLUME_USD\":\"1500\",\"LOW_CAP_MIN_AGE_MINUTES\":\"5\",\"LOW_CAP_CANDIDATE_MAX_AGE_SECONDS\":\"900\",\"LOW_CAP_MIN_BUY_SELL_RATIO_5M\":\"1.35\",\"LOW_CAP_MIN_VOLUME_5M_USD\":\"750\",\"LOW_CAP_MIN_VOLUME_ACCELERATION_5M\":\"1.25\",\"LOW_CAP_MIN_TREND_1H_PCT\":\"3\",\"LOW_CAP_MIN_SCORE\":\"45\",\"LOW_CAP_LIQUIDITY_EXIT_RATIO\":\"0.80\",\"LOW_CAP_SELL_PRESSURE_RATIO\":\"0.75\",\"LOW_CAP_SELL_PRESSURE_MIN_VOLUME_USD\":\"750\",\"LOW_CAP_TREND_EXIT_PCT\":\"-5\",\"LOW_CAP_LOSS_EXIT_PCT\":\"-3\",\"LOW_CAP_PEAK_DRAWDOWN_EXIT_PCT\":\"8\",\"LOW_CAP_MAX_LIQUIDITY_POSITION_PCT\":\"2\",\"NADFUN_API_URL\":\"https://api.nad.fun\",\"LOW_CAP_FLOW_API_CANDIDATE_LIMIT\":\"4\",\"FLOW_API_REFRESH_MS\":\"30000\"}"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GELD_BOT",
        "class_name": "GeldBot"
      },
      {
        "name": "GELD_STATE",
        "class_name": "GeldState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GeldContainer",
        "GeldState"
      ]
    },
    {
      "tag": "v2-free-workers",
      "new_sqlite_classes": [
        "GeldBot"
      ],
      "deleted_classes": [
        "GeldContainer"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
