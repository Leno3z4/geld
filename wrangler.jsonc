{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geld",
  "main": "worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "GELD_LIVE_TRADING": "true",
    "GELD_AUTO_START": "true",
    "MONAD_RPC_URL": "https://rpc.monad.xyz",
    "MIN_LIQUIDITY_USD": "100000",
    "MIN_ESTABLISHED_AGE_MINUTES": "30",
    "MIN_HOLDERS": "25",
    "MIN_VOLUME_MON": "100",
    "STATE_SYNC_URL": "https://geld.mahoraga6190.workers.dev/internal/state/singleton"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GELD_BOT",
        "class_name": "GeldBot"
      },
      {
        "name": "GELD_STATE",
        "class_name": "GeldState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GeldContainer",
        "GeldState"
      ]
    },
    {
      "tag": "v2-free-workers",
      "new_sqlite_classes": [
        "GeldBot"
      ],
      "deleted_classes": [
        "GeldContainer"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
